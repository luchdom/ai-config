{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luchdom.local/schemas/linear-delivery-loop/worker-result-1.0.schema.json",
  "title": "WorkerResult 1.0",
  "description": "Non-authoritative worker proposal consumed only by ApplyCheckpoint.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "preparedIterationId", "runId", "workflowId", "issueId", "transitionId", "outcome", "completedStage", "proposedNextStage", "artifactManifest", "changedPaths", "summary", "proposedExternalTransitions", "pause", "observed"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "preparedIterationId": {"type": "string", "format": "uuid"},
    "runId": {"type": "string", "format": "uuid"}, "workflowId": {"type": "string", "format": "uuid"},
    "issueId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"}, "transitionId": {"type": "string", "format": "uuid"},
    "outcome": {"enum": ["advanced", "completed", "paused", "failed", "external-wait"]},
    "completedStage": {"enum": ["initialized", "plan", "clarify", "task", "audit", "implement", "review", "qa", "docs", "publication", "completion"]},
    "proposedNextStage": {"oneOf": [{"type": "null"}, {"enum": ["plan", "clarify", "task", "audit", "implement", "review", "qa", "docs", "publication", "completion", "paused"]}]},
    "artifactManifest": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "changedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
    "proposedExternalTransitions": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["provider", "action", "externalId", "reason"],
        "properties": {
          "provider": {"enum": ["linear", "github", "ntfy"]}, "action": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"},
          "externalId": {"type": "string", "minLength": 1, "maxLength": 128}, "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "pause": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["reasonCode", "decisionRequired", "question"],
         "properties": {"reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "decisionRequired": {"type": "boolean"}, "question": {"type": "string", "minLength": 1, "maxLength": 1024}}}
      ]
    },
    "observed": {
      "type": "object", "additionalProperties": false, "required": ["repositoryId", "physicalWorktreeFingerprint", "headSha"],
      "properties": {"repositoryId": {"type": "string", "pattern": "^repo-[a-f0-9]{24}$"}, "physicalWorktreeFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "headSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}
    }
  },
  "x-luchdom-runtimeParity": {
    "version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract",
    "constraints": [{"id": "safe-relative-paths"}, {"id": "proposal-only-no-authority"}, {"id": "no-raw-capability-or-nonce"}, {"id": "no-secret-like-material"}]
  }
}
