{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luchdom.local/schemas/linear-delivery-loop/tracking-config-1.0.schema.json",
  "title": "TrackingConfig 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "controlPlaneVersion", "supervisorVersion", "repositoryKey", "workspace", "team", "project", "owner", "states", "labels", "linear", "ntfy"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "controlPlaneVersion": {"const": "1.0"},
    "supervisorVersion": {"const": "1.0"},
    "repositoryKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "workspace": {"$ref": "#/$defs/idName"},
    "team": {"type": "object", "additionalProperties": false, "required": ["id", "key"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "key": {"const": "SAAS"}}},
    "project": {"$ref": "#/$defs/idName"},
    "owner": {"$ref": "#/$defs/idName"},
    "states": {"type": "object", "additionalProperties": false, "required": ["backlog", "todo", "inProgress", "inReview", "done"], "properties": {"backlog": {"$ref": "#/$defs/idName"}, "todo": {"$ref": "#/$defs/idName"}, "inProgress": {"$ref": "#/$defs/idName"}, "inReview": {"$ref": "#/$defs/idName"}, "done": {"$ref": "#/$defs/idName"}}},
    "labels": {"type": "object", "additionalProperties": false, "required": ["autonomous", "needsRefinement", "needsHuman", "externalIntegration", "stop"], "properties": {"autonomous": {"$ref": "#/$defs/idName"}, "needsRefinement": {"$ref": "#/$defs/idName"}, "needsHuman": {"$ref": "#/$defs/idName"}, "externalIntegration": {"$ref": "#/$defs/idName"}, "stop": {"$ref": "#/$defs/idName"}}},
    "linear": {"type": "object", "additionalProperties": false, "required": ["endpoint", "allowedHost", "apiKeyEnvironmentVariable", "timeoutSeconds", "maxAttempts"], "properties": {"endpoint": {"type": "string", "pattern": "^https://"}, "allowedHost": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}, "apiKeyEnvironmentVariable": {"const": "LINEAR_API_KEY"}, "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60}, "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 8}}},
    "ntfy": {"type": "object", "additionalProperties": false, "required": ["enabled", "endpointEnvironmentVariable", "topicEnvironmentVariable", "tokenEnvironmentVariable", "allowedHosts", "maxAttempts"], "properties": {"enabled": {"type": "boolean"}, "endpointEnvironmentVariable": {"const": "NTFY_URL"}, "topicEnvironmentVariable": {"const": "NTFY_TOPIC"}, "tokenEnvironmentVariable": {"const": "NTFY_TOKEN"}, "allowedHosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}}, "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 8}}}
  },
  "$defs": {"idName": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "name": {"type": "string", "minLength": 1, "maxLength": 128}}}},
  "x-luchdom-runtimeParity": {"version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract", "constraints": [{"id": "tracking-identifier-only-configuration"}, {"id": "no-secret-like-material"}]}
}
