{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "repository-memory-context-envelope.schema.json", "title": "Repository Memory Context Delivery V1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "developer", "tool", "authenticated", "accounting"],
  "properties": {"schemaVersion": {"const": "1.0"}, "developer": {"type": "object", "additionalProperties": false, "required": ["role", "content"], "properties": {"role": {"const": "developer"}, "content": {"type": "string", "minLength": 1, "maxLength": 2048}}}, "tool": {"type": "object", "additionalProperties": false, "required": ["role", "name", "content"], "properties": {"role": {"const": "tool"}, "name": {"const": "repository_memory_context"}, "content": {"type": "string", "minLength": 1, "maxLength": 98304}}}, "authenticated": {"type": "object", "additionalProperties": false, "required": ["stage", "contextPayloadSha256", "workflowId", "issueId", "completionBoundary", "provider", "mutationScopeSha256", "mutationScopeCount"], "properties": {"stage": {"enum": ["planner", "implementer", "code-reviewer", "qa"]}, "contextPayloadSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "workflowId": {"type": "string", "format": "uuid"}, "issueId": {"type": ["string", "null"]}, "completionBoundary": {"type": "string", "minLength": 1}, "provider": {"enum": ["none", "linear"]}, "mutationScopeSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "mutationScopeCount": {"type": "integer", "minimum": 0, "maximum": 32}}}, "accounting": {"type": "object", "additionalProperties": false, "required": ["recordsUsed", "contextOmitted", "charactersUsed", "bytesUsed"], "properties": {"recordsUsed": {"type": "integer", "minimum": 0, "maximum": 32}, "contextOmitted": {"type": "integer", "minimum": 0}, "charactersUsed": {"type": "string", "pattern": "^[0-9]{6}$"}, "bytesUsed": {"type": "string", "pattern": "^[0-9]{6}$"}}}},
  "x-luchdom-runtimeParity": {"version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract", "constraints": [{"id": "tool-role-untrusted-envelope"}, {"id": "canonical-context-escaping"}, {"id": "inclusive-sentinel-accounting"}, {"id": "authenticated-selector-invariance"}, {"id": "whole-item-budgets"}, {"id": "no-authority-from-memory"}]}
}
