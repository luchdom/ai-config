{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "repository-memory-promotion.schema.json", "title": "Repository Memory Promotion Manifest V1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "repositoryKey", "curationWorkflowId", "headSha", "physicalWorktreeFingerprint", "producer", "createdAt", "compatibilityClass", "batchPromotionId", "decision", "sourceArtifacts", "candidates", "noCandidatesReason", "noCandidatesSummary", "docsAttestationRef", "promotionManifestPayloadSha256"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "repositoryId": {"type": "string"}, "repositoryKey": {"type": "string"}, "curationWorkflowId": {"type": "string", "format": "uuid"}, "headSha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, "physicalWorktreeFingerprint": {"$ref": "#/$defs/digest"}, "producer": {"const": "docs-as-code"}, "createdAt": {"type": "string", "format": "date-time"}, "compatibilityClass": {"enum": ["current-completion-v2", "legacy-completion-v1"]}, "batchPromotionId": {"type": "string", "format": "uuid"}, "decision": {"enum": ["promotion-approved", "no-candidates"]},
    "sourceArtifacts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["workflowId", "workKey", "path", "stage", "sha256", "completed"], "properties": {"workflowId": {"type": ["string", "null"]}, "workKey": {"type": ["string", "null"]}, "path": {"type": "string"}, "stage": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}, "completed": {"const": true}}}},
    "candidates": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/candidate"}}, "noCandidatesReason": {"type": ["string", "null"], "maxLength": 64}, "noCandidatesSummary": {"type": ["string", "null"], "maxLength": 500}, "docsAttestationRef": {"type": ["string", "null"]}, "promotionManifestPayloadSha256": {"$ref": "#/$defs/digest"}
  }, "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidateId", "candidatePromotionId", "targetRecordId", "targetRecordVersion", "targetPath", "kind", "topics", "paths", "stages", "work", "title", "summary", "assertions", "provenance", "confidence", "freshness", "lifecycle", "retention", "supersedes", "restores", "createdAt", "reviewedAt", "archiveReason", "redactionReason", "candidateIntentSha256"], "properties": {"candidateId": {"type": "string", "format": "uuid"}, "candidatePromotionId": {"type": "string", "format": "uuid"}, "targetRecordId": {"type": "string"}, "targetRecordVersion": {"type": "integer", "minimum": 1, "maximum": 9999}, "targetPath": {"type": "string"}, "kind": {"type": "string"}, "topics": {"type": "array", "items": {"type": "string"}}, "paths": {"type": "array", "items": {"type": "string"}}, "stages": {"type": "array", "items": {"type": "string"}}, "work": {"type": ["object", "null"]}, "title": {"type": ["string", "null"]}, "summary": {"type": ["string", "null"]}, "assertions": {"type": "array", "items": {"type": "object"}}, "provenance": {"type": "array", "items": {"type": "object"}}, "confidence": {"type": "string"}, "freshness": {"type": "object"}, "lifecycle": {"type": "string"}, "retention": {"type": "object"}, "supersedes": {"type": "array", "items": {"type": "object"}}, "restores": {"type": ["object", "null"]}, "createdAt": {"type": "string", "format": "date-time"}, "reviewedAt": {"type": "string", "format": "date-time"}, "archiveReason": {"type": ["string", "null"]}, "redactionReason": {"type": ["string", "null"]}, "candidateIntentSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
  },
  "x-luchdom-runtimeParity": {"version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract", "constraints": [{"id": "manifest-decision-cross-fields"}, {"id": "canonical-candidate-order"}, {"id": "distinct-curation-workflow"}, {"id": "canonical-digest-projections"}, {"id": "no-authority-fields"}, {"id": "no-secret-like-material"}]}
}
