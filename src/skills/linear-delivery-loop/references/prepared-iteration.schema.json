{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luchdom.local/schemas/linear-delivery-loop/prepared-iteration-1.0.schema.json",
  "title": "PreparedIteration 1.0",
  "description": "One engine-prepared autonomous iteration; contains only an opaque capability reference and hash.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "preparedIterationId", "issueId", "workflowId", "runId", "repositoryId", "repositoryKey", "stateHome", "physicalWorktreeFingerprint", "worktreePath", "stateRevision", "stage", "expiresAt", "capabilityRef", "capabilityHash"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "preparedIterationId": {"type": "string", "format": "uuid"},
    "issueId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"},
    "workflowId": {"type": "string", "format": "uuid"},
    "runId": {"type": "string", "format": "uuid"},
    "repositoryId": {"type": "string", "pattern": "^repo-[a-f0-9]{24}$"},
    "repositoryKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "stateHome": {"type": "string", "minLength": 3, "maxLength": 1024},
    "physicalWorktreeFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "worktreePath": {"type": "string", "minLength": 3, "maxLength": 1024},
    "stateRevision": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["initialized", "plan", "clarify", "task", "audit", "implement", "review", "qa", "docs", "publication", "completion", "paused"]},
    "expiresAt": {"type": "string", "format": "date-time"},
    "capabilityRef": {"type": "string", "minLength": 3, "maxLength": 1024},
    "capabilityHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "x-luchdom-runtimeParity": {
    "version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract",
    "constraints": [
      {"id": "canonical-absolute-paths"}, {"id": "engine-owned-capability-reference"},
      {"id": "no-raw-capability-or-nonce"}, {"id": "no-secret-like-material"}
    ]
  }
}
