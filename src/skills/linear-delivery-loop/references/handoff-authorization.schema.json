{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luchdom.local/schemas/linear-delivery-loop/handoff-authorization-1.0.schema.json",
  "title": "HandoffAuthorization 1.0",
  "description": "Engine-owned internal one-shot grant consumed inside the canonical base mutex. It binds only hashes and revisions; the raw nonce remains in a state-home sidecar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "operationId",
    "workflowId",
    "repositoryKey",
    "sourceFingerprint",
    "destinationFingerprint",
    "expectedPathDigest",
    "requestHash",
    "reservationId",
    "reservationRevision",
    "nonceSha256",
    "status"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "revision": {"type": "integer", "minimum": 1},
    "operationId": {"type": "string", "format": "uuid"},
    "workflowId": {"type": "string", "format": "uuid"},
    "repositoryKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "sourceFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "destinationFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "expectedPathDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "requestHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reservationId": {"type": "string", "format": "uuid"},
    "reservationRevision": {"type": "integer", "minimum": 1},
    "nonceSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "status": {"enum": ["prepared", "consumed", "revoked"]}
  },
  "x-luchdom-runtimeParity": {
    "version": "1.0",
    "runtimeValidator": "scripts.contracts.validate_contract",
    "constraints": [
      {"id": "source-destination-fingerprints-differ"},
      {"id": "one-shot-authorization-state"},
      {"id": "no-raw-capability-or-nonce"},
      {"id": "no-secret-like-material"}
    ]
  }
}
