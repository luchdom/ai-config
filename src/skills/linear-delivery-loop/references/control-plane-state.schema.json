{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luchdom.local/schemas/linear-delivery-loop/control-plane-state-1.0.schema.json",
  "title": "ControlPlaneState 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "decisions", "publicationRequests", "followUps", "attentionEvents", "notifications", "selectionClaims"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "revision": {"type": "integer", "minimum": 0},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "publicationRequests": {"type": "array", "items": {"$ref": "#/$defs/publication"}},
    "followUps": {"type": "array", "items": {"$ref": "#/$defs/followUp"}},
    "attentionEvents": {"type": "array", "items": {"$ref": "#/$defs/attention"}},
    "notifications": {"type": "array", "items": {"$ref": "#/$defs/notification"}},
    "selectionClaims": {"type": "array", "items": {"$ref": "#/$defs/selection"}}
  },
  "$defs": {
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "issueId", "createdAt", "sourceTimestamp", "status", "link", "summary", "data"],
      "properties": {
        "id": {"type": "string", "pattern": "^decision-[a-f0-9]{24}$"}, "kind": {"const": "needs-human"}, "issueId": {"$ref": "#/$defs/issueId"},
        "createdAt": {"$ref": "#/$defs/time"}, "sourceTimestamp": {"$ref": "#/$defs/time"}, "status": {"enum": ["pending", "consumed"]}, "link": {"$ref": "#/$defs/link"}, "summary": {"$ref": "#/$defs/summary"},
        "data": {"type": "object", "additionalProperties": false, "required": ["options", "recommendation", "ownerId", "configDigest", "repositoryId", "replySyntax", "consumedReplyId", "consumedReplyTimestamp"], "properties": {
          "options": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "consequence"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "consequence": {"$ref": "#/$defs/summary"}}}},
          "recommendation": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "ownerId": {"type": "string", "minLength": 1}, "configDigest": {"$ref": "#/$defs/digest"}, "repositoryId": {"$ref": "#/$defs/repositoryId"}, "replySyntax": {"type": "string", "minLength": 1}, "consumedReplyId": {"type": ["string", "null"]}, "consumedReplyTimestamp": {"type": ["string", "null"]}, "selectedOption": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }}
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "issueId", "createdAt", "sourceTimestamp", "status", "link", "summary", "data"],
      "properties": {
        "id": {"type": "string", "pattern": "^publication-[a-f0-9]{24}$"}, "kind": {"const": "publication-refusal"}, "issueId": {"$ref": "#/$defs/issueId"}, "createdAt": {"$ref": "#/$defs/time"}, "sourceTimestamp": {"$ref": "#/$defs/time"}, "status": {"enum": ["pending", "authorized"]}, "link": {"$ref": "#/$defs/link"}, "summary": {"$ref": "#/$defs/summary"},
        "data": {"type": "object", "additionalProperties": false, "required": ["operationId", "headSha", "evidence", "ownerId", "configDigest", "repositoryId", "refusalKind", "replySyntax", "consumedReplyId", "consumedReplyTimestamp"], "properties": {
          "operationId": {"type": "string", "minLength": 1}, "headSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "ownerId": {"type": "string", "minLength": 1}, "configDigest": {"$ref": "#/$defs/digest"}, "repositoryId": {"$ref": "#/$defs/repositoryId"}, "refusalKind": {"enum": ["stable", "exhausted", "ambiguous"]}, "replySyntax": {"type": "string", "minLength": 1}, "consumedReplyId": {"type": ["string", "null"]}, "consumedReplyTimestamp": {"type": ["string", "null"]},
          "evidence": {"type": "object", "additionalProperties": false, "required": ["issueState", "reservationId", "worktreePath", "branch", "prId"], "properties": {"issueState": {"type": "string", "minLength": 1}, "reservationId": {"type": "string", "minLength": 1}, "worktreePath": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "prId": {"type": "string", "minLength": 1}}}
        }}
      }
    },
    "followUp": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "issueId", "createdAt", "sourceTimestamp", "status", "link", "summary", "data"],
      "properties": {"id": {"type": "string", "pattern": "^(followup|proposal|failure)-[a-f0-9]{24}$"}, "kind": {"enum": ["needs-refinement", "external-integration", "worker-failure", "preflight-failure", "reconciliation-failure"]}, "issueId": {"$ref": "#/$defs/issueId"}, "createdAt": {"$ref": "#/$defs/time"}, "sourceTimestamp": {"$ref": "#/$defs/time"}, "status": {"const": "pending"}, "link": {"$ref": "#/$defs/link"}, "summary": {"$ref": "#/$defs/summary"}, "data": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["proposalType", "proposedState", "proposedLabel"], "properties": {"proposalType": {"enum": ["external-prerequisite", "issue-contract"]}, "proposedState": {"const": "Backlog"}, "proposedLabel": {"enum": ["needs-refinement", "external-integration"]}}}, {"type": "object", "additionalProperties": false, "required": ["sourceId"], "properties": {"sourceId": {"type": "string", "minLength": 1}}}]}}
    },
    "attention": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "issueId", "createdAt", "sourceTimestamp", "status", "link", "summary", "data"],
      "properties": {"id": {"type": "string", "pattern": "^attention-[a-f0-9]{24}$"}, "kind": {"enum": ["needs-human", "external-blocker", "multiple-wip", "publication-refusal", "worker-failure", "preflight-failure"]}, "issueId": {"$ref": "#/$defs/issueId"}, "createdAt": {"$ref": "#/$defs/time"}, "sourceTimestamp": {"$ref": "#/$defs/time"}, "status": {"const": "pending"}, "link": {"$ref": "#/$defs/link"}, "summary": {"$ref": "#/$defs/summary"}, "data": {"type": "object", "additionalProperties": false, "required": ["sourceId"], "properties": {"sourceId": {"type": "string", "minLength": 1}}}}
    },
    "notification": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "issueId", "createdAt", "sourceTimestamp", "status", "link", "summary", "data"],
      "properties": {"id": {"type": "string", "pattern": "^notification-[a-f0-9]{24}$"}, "kind": {"const": "ntfy"}, "issueId": {"$ref": "#/$defs/issueId"}, "createdAt": {"$ref": "#/$defs/time"}, "sourceTimestamp": {"$ref": "#/$defs/time"}, "status": {"enum": ["pending", "delivered", "failed"]}, "link": {"$ref": "#/$defs/link"}, "summary": {"$ref": "#/$defs/summary"}, "data": {"type": "object", "additionalProperties": false, "required": ["eventId", "attemptId", "attemptState", "completedAt", "outcome"], "properties": {"eventId": {"type": "string", "pattern": "^attention-[a-f0-9]{24}$"}, "attemptId": {"type": "string", "pattern": "^attempt-[a-f0-9]{24}$"}, "attemptState": {"enum": ["in-flight", "recovery-required", "terminal"]}, "completedAt": {"type": ["string", "null"]}, "outcome": {"type": ["object", "null"]}}}}
    },
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "issueId", "createdAt", "sourceTimestamp", "status", "link", "summary", "data"],
      "properties": {
        "id": {"type": "string", "pattern": "^selection-[a-f0-9]{24}$"}, "kind": {"const": "selection-claim"}, "issueId": {"$ref": "#/$defs/issueId"}, "createdAt": {"$ref": "#/$defs/time"}, "sourceTimestamp": {"$ref": "#/$defs/time"}, "status": {"enum": ["pending", "in-flight", "protected", "recovering", "consumed", "inert"]}, "link": {"$ref": "#/$defs/link"}, "summary": {"$ref": "#/$defs/summary"},
        "data": {
          "type": "object", "additionalProperties": false,
          "required": ["configDigest", "snapshotDigest", "repositoryKey", "repositoryId", "ownerId", "operationId", "startedAt", "executionOwnerId", "executionLeaseRevision", "executionLeaseExpiresAt", "recoveryGeneration", "recoveryOwnerId", "recoveryLeaseRevision", "recoveryLeaseExpiresAt", "recoveryStartedAt", "recoveryProof", "terminalResult"],
          "properties": {
            "configDigest": {"$ref": "#/$defs/digest"}, "snapshotDigest": {"$ref": "#/$defs/digest"}, "repositoryKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "repositoryId": {"$ref": "#/$defs/repositoryId"}, "ownerId": {"type": "string", "minLength": 1},
            "operationId": {"type": ["string", "null"]}, "startedAt": {"type": ["string", "null"]}, "executionOwnerId": {"type": ["string", "null"]}, "executionLeaseRevision": {"type": ["integer", "null"], "minimum": 1}, "executionLeaseExpiresAt": {"type": ["string", "null"]},
            "recoveryGeneration": {"type": "integer", "minimum": 0}, "recoveryOwnerId": {"type": ["string", "null"]}, "recoveryLeaseRevision": {"type": ["integer", "null"], "minimum": 1}, "recoveryLeaseExpiresAt": {"type": ["string", "null"]}, "recoveryStartedAt": {"type": ["string", "null"]},
            "recoveryProof": {"type": ["object", "null"], "additionalProperties": false, "required": ["status", "proofId", "operationId", "previousOwnerId", "previousLeaseRevision", "previousLeaseExpiresAt", "recoveryOwnerId", "recoveryLeaseRevision", "recoveryLeaseExpiresAt", "observedAt", "reason"], "properties": {"status": {"const": "authorized"}, "proofId": {"type": "string", "minLength": 1}, "operationId": {"type": "string", "minLength": 1}, "previousOwnerId": {"type": "string", "minLength": 1}, "previousLeaseRevision": {"type": "integer", "minimum": 1}, "previousLeaseExpiresAt": {"$ref": "#/$defs/time"}, "recoveryOwnerId": {"type": "string", "minLength": 1}, "recoveryLeaseRevision": {"type": "integer", "minimum": 1}, "recoveryLeaseExpiresAt": {"$ref": "#/$defs/time"}, "observedAt": {"$ref": "#/$defs/time"}, "reason": {"enum": ["owner-dead", "lease-expired"]}}},
            "terminalResult": {"type": ["object", "null"], "additionalProperties": false, "required": ["status", "issueId", "operationId"], "properties": {"status": {"enum": ["claimed", "reconciled", "recovered", "inert"]}, "issueId": {"$ref": "#/$defs/issueId"}, "operationId": {"type": "string", "minLength": 1}}}
          }
        }
      }
    },
    "issueId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"},
    "time": {"type": "string", "format": "date-time"},
    "link": {"type": "string", "pattern": "^https://"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "attestationId": {"type": "string", "pattern": "^preflight-[a-f0-9]{32}$"},
    "repositoryId": {"type": "string", "pattern": "^repo-[a-f0-9]{24}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "x-luchdom-runtimeParity": {"version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract", "constraints": [{"id": "canonical-record-identities"}, {"id": "no-raw-capability-or-nonce"}, {"id": "no-secret-like-material"}]}
}
