{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luchdom.local/schemas/linear-delivery-loop/editing-reservation-1.0.schema.json",
  "title": "EditingReservations 1.0",
  "description": "Repository-scoped mutation reservations shared by autonomous, semi-autonomous, and manual delivery.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "revision", "reservations", "consumedObservationIds", "consumedAuthorizationIds"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "revision": {"type": "integer", "minimum": 1},
    "reservations": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["reservationId", "workflowId", "issueId", "repositoryId", "repositoryKey", "physicalWorktreeFingerprint", "worktreePath", "policy", "ownerId", "runId", "status", "revision", "heartbeatNs", "expiresAtNs", "protectedWork", "releaseAuthorizationRef", "cleanupAuthorizationRefs", "pendingHandoffOperationId"],
        "properties": {
          "reservationId": {"type": "string", "format": "uuid"}, "workflowId": {"type": "string", "format": "uuid"},
          "issueId": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"}]},
          "repositoryId": {"type": "string", "pattern": "^repo-[a-f0-9]{24}$"}, "repositoryKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "physicalWorktreeFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "worktreePath": {"type": "string", "minLength": 3, "maxLength": 1024},
          "policy": {"enum": ["autonomous", "semi-autonomous", "manual"]}, "ownerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "runId": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uuid"}]},
          "status": {"enum": ["live", "expired", "protected", "handoff-pending", "released", "reclaimed"]},
          "revision": {"type": "integer", "minimum": 1}, "heartbeatNs": {"type": "integer", "minimum": 0}, "expiresAtNs": {"type": "integer", "minimum": 1},
          "protectedWork": {
            "type": "object", "additionalProperties": false,
            "required": ["dirty", "branch", "headSha", "unpushed", "unmerged", "prOpen", "prId", "prState", "accessible", "ambiguous", "planningOnly"],
            "properties": {
              "dirty": {"type": "boolean"}, "branch": {"type": "string", "minLength": 1, "maxLength": 256}, "headSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "unpushed": {"type": "boolean"}, "unmerged": {"type": "boolean"}, "prOpen": {"type": "boolean"},
              "prId": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}]},
              "prState": {"enum": ["not-applicable", "unknown", "open", "closed", "merged"]},
              "accessible": {"type": "boolean"}, "ambiguous": {"type": "boolean"}, "planningOnly": {"type": "boolean"}
            }
          },
          "releaseAuthorizationRef": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 3, "maxLength": 1024}]},
          "cleanupAuthorizationRefs": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 3, "maxLength": 1024}
          },
          "pendingHandoffOperationId": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uuid"}]}
        }
      }
    },
    "consumedObservationIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "consumedAuthorizationIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}
  },
  "x-luchdom-runtimeParity": {
    "version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract",
    "constraints": [{"id": "canonical-absolute-paths"}, {"id": "unique-reservation-identities"}, {"id": "no-raw-capability-or-nonce"}, {"id": "no-secret-like-material"}]
  }
}
