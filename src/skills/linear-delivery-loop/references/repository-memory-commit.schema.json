{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "repository-memory-commit.schema.json", "title": "Repository Memory Atomic Batch Commit V1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "repositoryKey", "batchPromotionId", "promotionManifestPayloadSha256", "promotionBatchRequestSha256", "records", "batchCommitPayloadSha256"],
  "properties": {"schemaVersion": {"const": "1.0"}, "repositoryId": {"type": "string"}, "repositoryKey": {"type": "string"}, "batchPromotionId": {"type": "string", "format": "uuid"}, "promotionManifestPayloadSha256": {"$ref": "#/$defs/digest"}, "promotionBatchRequestSha256": {"$ref": "#/$defs/digest"}, "records": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["candidateId", "candidatePromotionId", "targetPath", "candidateIntentSha256", "recordPayloadSha256", "recordFileSha256"], "properties": {"candidateId": {"type": "string", "format": "uuid"}, "candidatePromotionId": {"type": "string", "format": "uuid"}, "targetPath": {"type": "string"}, "candidateIntentSha256": {"$ref": "#/$defs/digest"}, "recordPayloadSha256": {"$ref": "#/$defs/digest"}, "recordFileSha256": {"$ref": "#/$defs/digest"}}}}, "batchCommitPayloadSha256": {"$ref": "#/$defs/digest"}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "x-luchdom-runtimeParity": {"version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract", "constraints": [{"id": "canonical-digest-projections"}, {"id": "canonical-candidate-order"}, {"id": "complete-marker-owned-set"}, {"id": "safe-repository-paths"}, {"id": "no-secret-like-material"}]}
}
