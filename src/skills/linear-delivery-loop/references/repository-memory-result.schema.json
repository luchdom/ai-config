{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-memory-result.schema.json",
  "title": "Repository Memory Retrieval Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "repositoryKey", "querySha256", "indexSemanticSha256", "markerSetSha256", "items", "accounting", "diagnostics"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "repositoryId": {"type": "string", "minLength": 1, "maxLength": 128},
    "repositoryKey": {"type": "string", "minLength": 1, "maxLength": 64},
    "querySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "indexSemanticSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "markerSetSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "items": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["recordId", "recordVersion", "kind", "title", "summary", "assertions", "confidence", "provenance", "recordPayloadSha256", "recordFileSha256", "rank", "duplicateProvenance"], "properties": {
      "recordId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
      "recordVersion": {"type": "integer", "minimum": 1, "maximum": 9999},
      "kind": {"enum": ["concept", "decision", "how-to", "runbook", "troubleshooting", "constraint", "reference"]},
      "title": {"type": "string", "minLength": 1, "maxLength": 200},
      "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
      "assertions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["key", "valueType", "comparison", "value", "provenanceRefs"], "properties": {"key": {"type": "string"}, "valueType": {"enum": ["string", "integer", "boolean", "string-set"]}, "comparison": {"const": "equals"}, "value": {"oneOf": [{"type": "string"}, {"type": "integer"}, {"type": "boolean"}, {"type": "array", "items": {"type": "string"}}]}, "provenanceRefs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string"}}}}},
      "confidence": {"enum": ["current-source-bound", "source-evidence-bound", "legacy-evidence-bound"]},
      "provenance": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "sha256", "workflowId", "workKey", "stage", "anchor"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["repository-source", "delivery-artifact", "legacy-delivery-artifact"]}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "workflowId": {"type": ["string", "null"]}, "workKey": {"type": ["string", "null"]}, "stage": {"type": ["string", "null"]}, "anchor": {"type": ["string", "null"]}}}},
      "recordPayloadSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "recordFileSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "rank": {"type": "array", "minItems": 10, "maxItems": 10},
      "duplicateProvenance": {"type": "array", "maxItems": 31, "items": {"type": "object", "additionalProperties": false, "required": ["recordId", "recordVersion", "provenance"], "properties": {"recordId": {"type": "string"}, "recordVersion": {"type": "integer", "minimum": 1}, "provenance": {"type": "array", "minItems": 1, "maxItems": 32}}}}
    }}},
    "accounting": {"type": "object", "additionalProperties": false, "required": ["recordsUsed", "charactersUsed", "bytesUsed"], "properties": {"recordsUsed": {"type": "integer", "minimum": 0, "maximum": 32}, "charactersUsed": {"type": "integer", "minimum": 2, "maximum": 48000}, "bytesUsed": {"type": "integer", "minimum": 0, "maximum": 98304}}},
    "diagnostics": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
  },
  "x-luchdom-runtimeParity": {"version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract", "constraints": [{"id": "whole-item-budgets"}, {"id": "canonical-result-accounting"}, {"id": "complete-provenance"}, {"id": "no-authority-fields"}, {"id": "no-secret-like-material"}]}
}
