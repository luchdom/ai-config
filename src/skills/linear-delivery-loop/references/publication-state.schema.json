{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luchdom.local/schemas/linear-delivery-loop/publication-state-1.0.schema.json",
  "title": "PublicationState 1.0",
  "description": "Exact-head publication, retry, evidence, merge and repair state. Provider material is digest-referenced only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "repositoryKey", "workflowId", "issueId", "operationId", "idempotencyKey", "operation", "status", "branch", "baseRef", "baseSha", "headSha", "mergeSha", "pullRequest", "attemptCount", "retryCount", "nextRetryAt", "refusalKind", "providerEvidenceRef", "preservedState", "attestations", "providerOperationIds", "activeProviderOperation", "authorityReadback", "preparation", "evidenceFinalization", "evidenceFinalizationCount", "repairAttempt", "consumedReplyId", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "repositoryId": {"type": "string", "minLength": 1, "maxLength": 256},
    "repositoryKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "workflowId": {"type": "string", "format": "uuid"},
    "issueId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$"},
    "operationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "idempotencyKey": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "operation": {"enum": ["push", "pull-request", "squash-merge"]},
    "status": {"enum": ["prepared", "attempting", "retry-wait", "paused", "pushed", "pr-open", "head-gated", "merge-ready", "succeeded", "merged", "post-merge-validating", "repairing", "base-drift", "completed"]},
    "branch": {"type": "string", "pattern": "^codex/[A-Z][A-Z0-9]+-[1-9][0-9]*-(?:[a-z0-9]+(?:-[a-z0-9]+)*|repair-[1-3])$"},
    "baseRef": {"const": "main"},
    "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "mergeSha": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}]},
    "pullRequest": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "attemptCount": {"type": "integer", "minimum": 0, "maximum": 4},
    "retryCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "nextRetryAt": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "refusalKind": {"oneOf": [{"type": "null"}, {"enum": ["rate-limit", "provider-unavailable", "temporary-mergeability", "permission", "required-check", "branch-protection", "ruleset", "merge-queue", "policy", "ambiguous", "unclassified"]}]},
    "providerEvidenceRef": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
    "preservedState": {
      "type": "object", "additionalProperties": false,
      "required": ["issueState", "autonomous", "globalWip", "reservationId", "worktreePath", "physicalWorktreeFingerprint", "branch", "pullRequest", "evidenceRefs"],
      "properties": {
        "issueState": {"enum": ["In Progress", "In Review"]}, "autonomous": {"const": true}, "globalWip": {"const": true},
        "reservationId": {"type": "string", "minLength": 1}, "worktreePath": {"type": "string", "minLength": 3},
        "physicalWorktreeFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "branch": {"type": "string", "minLength": 1},
        "pullRequest": {"oneOf": [{"type": "null"}, {"type": "object"}]}, "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "attestations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/publicationAttestation"}},
    "providerOperationIds": {"type": "object", "additionalProperties": false, "required": ["push", "pull-request", "squash-merge"], "properties": {"push": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}, "pull-request": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}, "squash-merge": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}}},
    "activeProviderOperation": {"oneOf": [{"type": "null"}, {"enum": ["push", "pull-request", "squash-merge"]}]},
    "authorityReadback": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["issueId", "labels", "pullRequestId", "baseRef", "baseSha", "headSha", "mergeability", "evidenceRef", "expectedHeadSha"], "properties": {"issueId": {"type": "string"}, "labels": {"type": "array", "items": {"type": "string"}}, "pullRequestId": {}, "baseRef": {"const": "main"}, "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}, "headSha": {}, "mergeability": {}, "evidenceRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "expectedHeadSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}}}]},
    "preparation": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["branch", "baseSha", "headSha", "paths", "manifestDigest", "aggregateDigest"], "properties": {"branch": {"type": "string"}, "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}, "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}, "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "aggregateDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}]},
    "evidenceFinalization": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["headSha", "stagedPaths", "deltaDigest", "providerEvidenceRef"], "properties": {"headSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}, "stagedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "deltaDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "providerEvidenceRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}]},
    "evidenceFinalizationCount": {"type": "integer", "minimum": 0, "maximum": 1},
    "repairAttempt": {"type": "integer", "minimum": 0, "maximum": 3},
    "consumedReplyId": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
    "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "publicationAttestation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "attestationId", "publicationOperationId", "kind", "producer", "stage", "result", "provenanceRef", "exactSha", "issuedStateRevision", "recordedAt"],
      "properties": {
        "schemaVersion": {"const": "1.0"}, "attestationId": {"type": "string", "minLength": 1},
        "publicationOperationId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["pre-staging-aggregate", "exact-head-aggregate", "review", "qa", "qa-reuse", "docs", "evidence-convergence", "merge-readback", "exact-merge-aggregate"]},
        "producer": {"enum": ["gate-runner", "code-reviewer", "qa", "docs", "evidence-classifier", "provider-readback"]},
        "stage": {"enum": ["pre-merge", "post-merge"]}, "result": {"enum": ["passed", "failed"]},
        "provenanceRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "exactSha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "issuedStateRevision": {"type": "integer", "minimum": 0}, "recordedAt": {"type": "string", "format": "date-time"}
      }
    }
  },
  "x-luchdom-runtimeParity": {
    "version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract",
    "constraints": [{"id": "immutable-operation-and-head"}, {"id": "initial-plus-three-retries"}, {"id": "complete-preserved-state"}, {"id": "redacted-provider-evidence"}, {"id": "bounded-evidence-and-repair"}, {"id": "no-raw-capability-or-nonce"}, {"id": "no-secret-like-material"}]
  }
}
