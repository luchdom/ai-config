{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luchdom.local/schemas/linear-delivery-loop/trusted-observation-1.0.schema.json",
  "title": "TrustedObservation 1.0",
  "description": "Fresh one-shot adapter-attested provider observation. SAAS-46 supplies fixture adapters only; live adapters belong to SAAS-47/48.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "observationId", "observationRef", "adapterId", "adapterVersion", "adapterKind", "operationId", "repositoryId", "repositoryKey", "stateHome", "normalizedCommonDir", "branch", "headSha", "pullRequest", "observedAt", "expiresAt", "journalHash", "attestationHash", "consumedAt", "status"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "observationId": {"type": "string", "format": "uuid"},
    "observationRef": {"type": "string", "minLength": 3, "maxLength": 1024},
    "adapterId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"}, "adapterVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "adapterKind": {"enum": ["fixture", "trusted-local"]}, "operationId": {"type": "string", "format": "uuid"},
    "repositoryId": {"type": "string", "pattern": "^repo-[a-f0-9]{24}$"}, "repositoryKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "stateHome": {"type": "string", "minLength": 3, "maxLength": 1024},
    "normalizedCommonDir": {"type": "string", "minLength": 3, "maxLength": 1024}, "branch": {"type": "string", "minLength": 1, "maxLength": 256},
    "headSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "pullRequest": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["provider", "id", "state", "headSha"],
         "properties": {"provider": {"const": "github"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}, "state": {"enum": ["open", "closed", "merged"]}, "headSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}}
      ]
    },
    "observedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
    "journalHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "attestationHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "consumedAt": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]}, "status": {"enum": ["issued", "consumed", "revoked", "expired"]}
  },
  "x-luchdom-runtimeParity": {
    "version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract",
    "constraints": [{"id": "canonical-absolute-paths"}, {"id": "observation-time-order"}, {"id": "one-shot-observation-state"}, {"id": "no-raw-capability-or-nonce"}, {"id": "no-secret-like-material"}]
  }
}
