{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-memory-record.schema.json",
  "title": "Repository Memory Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordId", "recordVersion", "candidateId", "candidatePromotionId", "repositoryId", "repositoryKey", "filename", "candidateIntentSha256", "promotionManifestPayloadSha256", "recordPayloadSha256", "kind", "topics", "paths", "stages", "work", "title", "summary", "assertions", "provenance", "createdBy", "updatedBy", "confidence", "freshness", "lifecycle", "retention", "supersedes", "restores", "createdAt", "reviewedAt", "archiveReason", "redactionReason"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "recordId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "recordVersion": {"type": "integer", "minimum": 1, "maximum": 9999},
    "candidateId": {"type": "string", "format": "uuid"},
    "candidatePromotionId": {"type": "string", "format": "uuid"},
    "repositoryId": {"type": "string", "minLength": 8, "maxLength": 128},
    "repositoryKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "filename": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}\\.v[0-9]{4}\\.json$"},
    "candidateIntentSha256": {"$ref": "#/$defs/digest"},
    "promotionManifestPayloadSha256": {"$ref": "#/$defs/digest"},
    "recordPayloadSha256": {"$ref": "#/$defs/digest"},
    "kind": {"enum": ["concept", "decision", "how-to", "runbook", "troubleshooting", "constraint", "reference"]},
    "topics": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "paths": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "stages": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}},
    "work": {"type": ["object", "null"]},
    "title": {"type": ["string", "null"], "maxLength": 160},
    "summary": {"type": ["string", "null"], "maxLength": 2000},
    "assertions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/assertion"}},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/provenance"}},
    "createdBy": {"$ref": "#/$defs/curationIdentity"},
    "updatedBy": {"$ref": "#/$defs/curationIdentity"},
    "confidence": {"enum": ["current-source-bound", "source-evidence-bound", "legacy-evidence-bound", "not-applicable"]},
    "freshness": {"type": "object"},
    "lifecycle": {"enum": ["active", "archived", "redacted"]},
    "retention": {"type": "object"},
    "supersedes": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/recordRef"}},
    "restores": {"type": ["object", "null"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "archiveReason": {"type": ["string", "null"], "maxLength": 500},
    "redactionReason": {"type": ["string", "null"], "maxLength": 64}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "recordRef": {"type": "object", "additionalProperties": false, "required": ["recordId", "recordVersion"], "properties": {"recordId": {"type": "string"}, "recordVersion": {"type": "integer", "minimum": 1}}},
    "assertion": {"type": "object", "additionalProperties": false, "required": ["key", "valueType", "comparison", "value", "provenanceRefs"], "properties": {"key": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){0,7}$", "maxLength": 128}, "valueType": {"enum": ["string", "integer", "boolean", "string-set"]}, "comparison": {"const": "equals"}, "value": {}, "provenanceRefs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "sha256", "workflowId", "workKey", "stage", "anchor"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "kind": {"enum": ["repository-source", "delivery-artifact", "legacy-delivery-artifact"]}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}, "workflowId": {"type": ["string", "null"]}, "workKey": {"type": ["string", "null"]}, "stage": {"type": ["string", "null"]}, "anchor": {"type": ["string", "null"], "maxLength": 256}}},
    "curationIdentity": {"type": "object", "additionalProperties": false, "required": ["workflowId", "candidatePromotionId", "promotionManifestPayloadSha256", "producer", "repositoryId", "headSha", "physicalWorktreeFingerprint", "observedAt"], "properties": {"workflowId": {"type": "string", "format": "uuid"}, "candidatePromotionId": {"type": "string", "format": "uuid"}, "promotionManifestPayloadSha256": {"$ref": "#/$defs/digest"}, "producer": {"const": "docs-as-code"}, "repositoryId": {"type": "string"}, "headSha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, "physicalWorktreeFingerprint": {"$ref": "#/$defs/digest"}, "observedAt": {"type": "string", "format": "date-time"}}}
  },
  "x-luchdom-runtimeParity": {"version": "1.0", "runtimeValidator": "scripts.contracts.validate_contract", "constraints": [{"id": "canonical-digest-projections"}, {"id": "typed-assertion-parity"}, {"id": "lifecycle-cross-fields"}, {"id": "sorted-normalized-arrays"}, {"id": "safe-repository-paths"}, {"id": "no-secret-like-material"}]}
}
